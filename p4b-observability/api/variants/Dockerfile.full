# Varian pembanding P2 Langkah 2: base image penuh (bukan slim). Build dari folder api/:
#   docker build -f variants/Dockerfile.full -t musiwatch/api:full .
FROM python:3.12
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app/ ./app/
RUN useradd --create-home appuser
USER appuser
ENV PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
